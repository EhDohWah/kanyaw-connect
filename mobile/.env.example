# Copy to .env and use your computer's address on the local network (a phone cannot reach "localhost").
# Phone on USB with `adb reverse`: use 127.0.0.1 instead (see docs/android-on-windows.md).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_REVERB_APP_KEY=local-dev-key
EXPO_PUBLIC_REVERB_HOST=192.168.1.20
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
EXPO_PUBLIC_FEED_SOURCE=mock
