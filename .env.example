# With Docker (docker compose up) this file is optional: every setting has a working default.
# Copy it to .env only to change something. The README explains each setting.
APP_NAME="Karen Connect"
APP_ENV=local
# Docker: leave empty to use the public development key. Never do that on a real server.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the separate Vue frontend
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API, comma separated (defaults to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://chat.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL ---
# Docker ignores DB_CONNECTION, DB_HOST, DB_PORT and the REDIS_* / CACHE_* / QUEUE_* lines below:
# the containers find each other by name. DB_DATABASE, DB_USERNAME and DB_PASSWORD are used (they create the database).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kanyaw_connect
DB_USERNAME=kanyaw
DB_PASSWORD=secret

# API only: no browser sessions
SESSION_DRIVER=array

# --- Redis (cache, queues, presence) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local
# Disk for chat attachments (private, served only through signed URLs). Use an S3 disk to keep them off the server.
# CHAT_ATTACHMENTS_DISK=local

# --- Sanctum ---
# Comma separated hosts allowed for stateful (cookie) auth. Bearer tokens do not need this.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Token lifetime in minutes (default 43200 = 30 days; 0 = never expires)
# SANCTUM_TOKEN_EXPIRATION=43200

# Optional prefix for new tokens (helps secret scanners find leaked tokens)
# SANCTUM_TOKEN_PREFIX=kc_

# --- Security ---
# Proxies whose X-Forwarded-* headers are trusted: "*" or a comma separated list of IPs / CIDRs.
# Required behind a reverse proxy / load balancer (HTTPS detection, client IPs, signed URLs).
# TRUSTED_PROXIES=
# Send Strict-Transport-Security on HTTPS requests
# SECURITY_HSTS=true
# Requests per minute per signed-in user (flood backstop) and sign-ups per hour per IP
# API_RATE_LIMIT=300
# REGISTER_RATE_LIMIT=20

# --- Broadcasting / Laravel Reverb (Phase 3) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=local-dev-key
REVERB_APP_SECRET=local-dev-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Address the Reverb server itself listens on (php artisan reverb:start)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Host names (not URLs: no https://, no port) of the pages allowed to open websockets, comma separated.
# "*" = any. Wildcards work: chat.example.org,*.example.org. Only the host of the browser's Origin is compared.
# A client that sends no Origin header (some native apps) is refused unless this is "*".
REVERB_ALLOWED_ORIGINS=*
# Max size in bytes of one published event. 5000 Burmese/Karen characters is ~15 KB in UTF-8.
REVERB_MAX_REQUEST_SIZE=100000

# --- LiveKit (Phase 4) ---
# What clients connect to (ws:// or wss://)
LIVEKIT_URL=ws://localhost:7880
# What this server calls for LiveKit's API (http:// or https://). Docker sets this itself (http://livekit:7880).
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-secret-secret-secret-secret-secret
LIVEKIT_TOKEN_TTL=3600
# Seconds to wait before handing the host role on when the host's connection drops (0 = immediately)
ROOM_HOST_TRANSFER_GRACE=0
# One-to-one calls: seconds a call rings, and seconds someone may drop out of an answered call and come back
CALL_RING_SECONDS=45
CALL_RECONNECT_GRACE=30

# --- End-to-end encryption and housekeeping ---
# Verify the Ed25519 signature on signed prekeys (needs ext-sodium)
# E2EE_VERIFY_SIGNED_PREKEY=true
# Deleted messages are removed for good after this many days
# CLEANUP_DELETED_MESSAGES_DAYS=30
# Uploads never attached to a message are deleted after this many hours
# CLEANUP_ORPHAN_ATTACHMENT_HOURS=24

# --- Web push notifications ---
# Create the keys once with `php artisan push:vapid`. Push stays off while they are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# Seconds a push service keeps a notification for a phone that is offline (default one day)
# PUSH_TTL=86400
# very-low | low | normal | high. Chat messages are "high" so phones in power-saving mode still deliver them.
# PUSH_URGENCY=high
# Show who wrote and the first words of plaintext messages (encrypted chats always say "New message")
# PUSH_SHOW_PREVIEW=true
# Do not push to people whose app is open
# PUSH_SKIP_ONLINE=true
# Extra push-service hosts to accept, comma separated, e.g. "push.example.net,*.example.org"
# (replaces the built-in list of Google, Mozilla, Apple and Windows push services)
# PUSH_ALLOWED_HOSTS=
# Endpoints must be https; only switch off to test against a plain-http fake push service
# PUSH_REQUIRE_HTTPS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Docker only (read by docker-compose.yml, not by the application) ---
# Port of the API on your machine
# APP_PORT=8000
# Ports of PostgreSQL and Redis on your machine (127.0.0.1 only). Change one if your own database already uses it.
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# Put demo people and chats (user1@example.com ... user5@example.com, password "password") in an EMPTY database.
# SEED_DEMO_DATA=true
# The address browsers send video to. 127.0.0.1 works for a browser on the same machine; for a phone on your
# network use this machine's address on that network (and set LIVEKIT_URL to match).
# LIVEKIT_NODE_IP=127.0.0.1
# Where LiveKit reports who joined and left. The default reaches the app container.
# LIVEKIT_WEBHOOK_URL=http://app/api/v1/webhooks/livekit
# Production only (docker-compose.prod.yml): your domain name. HTTPS is switched on for it automatically.
# SERVER_NAME=api.example.org
# Production only: the domain name of the video server (served over HTTPS by the same web server).
# LIVEKIT_DOMAIN=livekit.example.org
