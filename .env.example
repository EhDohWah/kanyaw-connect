APP_NAME="Karen Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the separate Vue frontend (used for CORS in Phase 6)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kanyaw_connect
DB_USERNAME=kanyaw
DB_PASSWORD=secret

# API only: no browser sessions
SESSION_DRIVER=array

# --- Redis (cache, queues, presence) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Sanctum ---
# Comma separated hosts allowed for stateful (cookie) auth. Bearer tokens do not need this.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Token lifetime in minutes (Phase 6 sets 30 days = 43200)
# SANCTUM_TOKEN_EXPIRATION=43200

# --- Broadcasting / Laravel Reverb (Phase 3) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=local-dev-key
REVERB_APP_SECRET=local-dev-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Address the Reverb server itself listens on (php artisan reverb:start)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma separated browser origins allowed to open websockets ("*" = any; set the frontend origin in production)
REVERB_ALLOWED_ORIGINS=*
# Max size in bytes of one published event. 5000 Burmese/Karen characters is ~15 KB in UTF-8.
REVERB_MAX_REQUEST_SIZE=100000

# --- LiveKit (Phase 4) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-secret-secret-secret-secret-secret
LIVEKIT_TOKEN_TTL=3600

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
